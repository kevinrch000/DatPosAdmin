
<%@ Master ClientIDMode="Static" Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="WebApplication1.Site" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="es">
<head id="Head1" runat="server">
    <meta content="charset=ISO-8859-1"/>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
     <title>Portal de Administración - Datpos</title>
     
       
      <link  rel="shortcut icon" href="http://www.datpos.com/wp-content/uploads/2020/10/favicon_Mesa-de-trabajo-1.png"  />
 
  

    <link href="Styles/Site.css" rel="stylesheet" type="text/css" />
    <link href="Styles/MenuVer.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/jquery-confirm.css" rel="stylesheet" type="text/css" />
    <script src="/Scripts/jquery-2.1.1.js" type="text/javascript"></script>
    <script src="/Scripts/bootstrap.js" type="text/javascript"></script>
    <script src="/Scripts/chart.js" type="text/javascript"></script>
    <script src="/Scripts/highcharts.js" type="text/javascript"></script>
    <script src="/Scripts/data.js" type="text/javascript"></script>
    <script src="/Scripts/jquery-confirm.js" type="text/javascript"></script>
    <link href="/Styles/css/alertify.core.css" rel="stylesheet" type="text/css" />
    <link href="/Styles/css/alertify.default.css" rel="stylesheet" type="text/css" />
    <script src="/Scripts/alertify.js" type="text/javascript"></script>

    <script src="../Javascript/Comun.js" type="text/javascript"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <script src="https://cdn.jsdelivr.net/npm/promise-polyfill"></script>
         <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.css">

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.js"></script>

      <%--ddl_autocomplete--%>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <link rel="stylesheet" href="//code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link href="Styles/ddl_autocomplete.css" rel="stylesheet" type="text/css" />
    <script src="../Javascript/ddl_autocomplete.js" type="text/javascript"></script>

    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css">

     <link href="Styles/Moderno.css" rel="stylesheet" type="text/css" />

      <%--Para generar exel--%>
     <script src="../Javascript/FileSaver.js" type="text/javascript"></script>

</head>
    
<style>
    /*
.graph {
    width: 80%;
    height: 468px;
    margin: 0 auto;
}*/
/********************/
/********************/
input:focus, input.form-control:focus {

    outline:none !important;
    outline-width: 0 !important;
    box-shadow: none;
    -moz-box-shadow: none;
    -webkit-box-shadow: none;
}
select:focus, select.form-control:focus {

    outline:none !important;
    outline-width: 0 !important;
    box-shadow: none;
    -moz-box-shadow: none;
    -webkit-box-shadow: none;
}
.textBienv {
	margin: auto;
	display: table;
}

h1 { 
	position: relative; 
	float: left;
	background: rgb(238, 244, 247);
	color: Black;
	font-size: 2.5em;
}

h1 span {
    position:absolute;
    right:0;
    width:0;
    background: rgb(238, 244, 247);
    border-left: 1px solid #000;
    animation: escribir 5s steps(32) infinite alternate;
}

@keyframes escribir {
    from { width: 100% }
    to { width:0 }
}
/*IM*/
.navbar-default {
    background-color: #f8f8f800;
    border-color: #f8f8f800;
}

.dataTables_wrapper .dataTables_filter input {
  border: none;
  padding: 8px 15px 8px 13px;
  border-bottom: 1px solid #228ac9  
}

.navbar-nav > li > a {
    padding-top: 1px;
}

.navbar {
    min-height: 0px;
}
.form-control[disabled], .form-control[readonly], fieldset[disabled] .form-control {
    background-color: #f5f5f5;
    opacity: 1;
}
</style>
<body>
    <form id="Form1" runat="server">
    <div id="menuver" class="nav-side-menu" onmouseover="MostrarMenu();" 
     >
        <div class="brand c-logo-menu">
            <a href="/Interfaces/Home.aspx">
                <img src="/Styles/img/icon/icon_LogoCircle.png" style="width: 33px;"></a>
        </div>
        <span class="glyphicon glyphicon-align-justify toggle-btn" style="font-size: 18px;
            margin-top: 5px;" data-toggle="collapse" data-target="#menu-content"></span>
        <div class="menu-list">
            <ul id="menu-content" class="menu-content collapse out">
                <li id="1_li_Administracion" data-toggle="collapse" 
                data-target="#1_ul_Administracion" class="collapsed"><a href="#">
                    <img src="/Styles/images/icono_adm.png" style="width: 25px;">Administración</a>
                </li>
                <ul class="sub-menu collapse" id="1_ul_Administracion">
                     <li id="2_li_Empresas"><a href="/Interfaces/AdministrarCompanias.aspx" style="left: 32px;">
                        <img src="/Styles/images/empresa.png" style="width: 17px; top: 12px; left: 33px;">Empresas</a></li>
                     <li id="2_li_Usuarios" ><a href="/Interfaces/AdministrarUsuarios.aspx" style="left: 32px;">
                        <img src="/Styles/images/usuarios.png" style="width: 17px; top: 12px; left: 33px;">Usuarios</a></li>
                </ul>
                <%--<li id="1_li_Consultas" data-toggle="collapse" data-target="#1_ul_Consultas" class="collapsed"><a href="#">
                    <img src="/Styles/images/icon/icon_saldo.png" style="width: 25px;">Consulta</a>
                </li>
                <ul id="1_ul_Consultas" class="sub-menu collapse">
                  <li id="3_li_Usuario"><a    href="/Interfaces/ConsultaUsuarios.aspx" style="left: 32px;">
                        <img src="/Styles/images/buscarUsuario.png" style="width: 17px; top: 12px; left: 33px;">Usuarios</a></li>
                    <li id="3_li_Empresa"><a href="/Interfaces/ConsultaEmpresas.aspx" style="left: 32px;">
                        <img src="/Styles/images/buscarEmpresa.png" style="width: 17px; top: 12px; left: 33px;">Empresas</a></li>
                </ul>--%>
                <li><a id="btnCerrarSesion"  runat="server" ><img src="/Styles/images/cerrarsesion.png"  style="WIDTH: 21px;" />Cerrar Sesion</a></li>
 
                        
            </ul>
        </div>
    </div>
    <div id="content" class="c-content" style="background-color:White">
        <header>
                <span class="c-menu-toggle" id="btnMenu" onclick="mostrar();"></span>
                <span class="header-title" id="id_titulo">Administración</span>
                <div class="c-menu-user">
                    <img src="/Styles/img/avatar.png" alt="Avatar">
                    <div class="info-name-type">
                       
                      
                          <span id="id_empresa" runat="server"><%Response.Write(Session("objBEUser").cdsc_empresa)%></span>
                        <span id="id_usuario" runat="server"><%Response.Write(Session("objBEUser").cdsc_usuario)%></span>

                    </div>
                     <li class="dropdown" style="list-style: none;TOP: -4px;">
                            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                            <i class="material-icons">settings</i></a>
                            <ul class="dropdown-menu" style="left:-161px;">
                              <li><a href="#">Mi perfil</a></li>
                              <li><a href="#" data-toggle="modal" data-target="#MoCambioPass" onclick="LimpiarPopUp();">Cambiar Contraseña</a></li>
                              <li><a href="#">Configuracion</a></li>
                            </ul>
                       </li>
                </div>
            </header>

             <div id="c-loader">
                <img src="/Styles/img/loader.gif" />
            </div>
            <script type="text/javascript">
                $('#c-loader').show(); 
            </script>




    <div class="adminActions content">
        <div class="adminButtons">
            <div class="col-sm-2 botonesnuevos">
                <a  href="#" class="botones_hab" id="btn_p_nuevo" style="background-color: #5bc0de;" title="Nuevo" onclick="Nuevo();">
                    <img src="../Styles/img/icon/icon_new.png" style="width: 23px; margin-top: 4px;" />
                </a>        
            </div>
            <div class="col-sm-2 botonesnuevos">
                <a href="#" class="botones_des" id="btn_p_editar" style="background-color: #f0ad4e;" title="Editar" onclick="Editar();" >
                <img src="../Styles/img/icon/icon_editW.png" style="width: 23px; margin-top: 4px;" /></a>
            </div>
            <div class="col-sm-2 botonesnuevos">
                <a href="#" class="botones_des" id="btn_p_grabar" style="background-color: #5cb85c;" title="Grabar" onclick="Guardar();">
                <img src="../Styles/img/icon/icon_save.png" style="width: 23px; margin-top: 4px;" /></a>
            </div>
            <div class="col-sm-2 botonesnuevos">
                <a href="#" class="botones_des" id="btn_p_eliminar" style="background-color: #f44336;" title="Eliminar" onclick="Eliminar();">
                <img src="../Styles/img/icon/icon_anular.png" title="Eliminar" style="width: 23px; margin-top: 4px;" /></a>
            </div>
            <div class="col-sm-2 botonesnuevos">
                <a href="#" class="botones_des fa fa-undo" id="btn_p_back" style="background-color: #727292;font-size: 27px;" title="Deshacer" onclick="Deshacer();"></a>
            </div>
            <div class="col-sm-2 botonesnuevos">
                <a href="#" class="botones_des fa fa-print" id="btn_p_imprimir" style="background-color: #b3962d;font-size: 27px;" title="Imprimir" onclick=""></a>
            </div>
        </div>
    </div>

       <div  id="divColsulta" class="adminActions content" style="visibility:hidden">
        <div class="adminButtons">
     <div class="col-sm-2 botonesnuevos"  >
                <a href="#" class="botones_des" id="btn_p_ejecutar" style="background-color: #f0ad4e;" title="Ejecutar" onclick="Ejecutar();" >
                <img src="../Styles/images/icon/icon_check.png" style="width: 23px; margin-top: 4px;" /></a>
            </div>
            <div class="col-sm-2 botonesnuevos"   >
                <a href="#" class="botones_des" id="btn_p_limpiar" style="background-color: #21b5d6;" title="Limpiar" onclick="Limpiar();">
                <img src="../Styles/images/icon/icon_limpiar.png" style="width: 23px; margin-top: 4px;" /></a>
            </div>
           

        </div>
    </div>


            <%--<div class="col-md-12" style="margin-top:80px">--%>
                <asp:ContentPlaceHolder ID="contenedormaster" runat="server" >
                </asp:ContentPlaceHolder>           
            <%--</div>--%>

    </div>
    
  

    </form>
    



    <%--Para generar exel--%>
    <ul id="contextMenu" class="dropdown-menu" role="menu" style="display:none" >
        <div class="input-group">
            <a><img src="../Styles/images/icon/icon_exel_c.png" style="width:14px;margin-right:8px;margin-left:5px" /></a> 
            <label style="color:#333;" >Exportar a Exel</label>
            
        </div>
    </ul>


    <script type="text/javascript">





        $(document).ready(function () {
            //            OcultarMenu();

            $("#id_usuario").text(objDA.cdsc_usuario);
            $("#id_empresa").text("user");
        });

        function MostrarMenu() {
            $("#menuver").removeClass("hiddenmenuvertical-menu");
            $("#content").removeClass("hiddenmenuvertical-header");
        }

        function OcultarMenu() {
            $("#menuver").addClass("hiddenmenuvertical-menu");
            $("#content").addClass("hiddenmenuvertical-header");
        }

        $('#c-loader').show();
        setTimeout(function () { $('#c-loader').hide(); }, 1000);
        function mostrar() {
            if ($("#menuver").hasClass("hiddenmenuvertical-menu") == true) {
                //quitas  --> MOSTRAR
                $("#menuver").removeClass("hiddenmenuvertical-menu");
                $("#content").removeClass("hiddenmenuvertical-header");
            } else {
                $("#menuver").addClass("hiddenmenuvertical-menu");
                $("#content").addClass("hiddenmenuvertical-header");
            }
        }
    </script>
</body>
</html>